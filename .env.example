# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Required ---

# GitHub Personal Access Token with read/write access to repository contents
# (fine-grained token: "Contents: Read and write" on the vault repository).
TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# GitHub user or organization that owns the vault repository.
OWNER=your-github-username

# Name of the repository that stores your Obsidian vault.
REPO=your-obsidian-vault

# OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional ---

# Branch to read from and write to. Default: main
BRANCH=main

# Root folder in the vault that contains input/, output/ and backup/. Default: AI_Formatter
FOLDER=AI_Formatter
